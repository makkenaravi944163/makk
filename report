select o.name table_name,
       c.name column_name
from sysobjects o,
     syscolumns c
where o.id=c.id
and (
c.name like '%social%'
or c.name like '%ssn%'
or c.name like '%tax%'
or c.name like '%employee%'
or c.name like '%address%'
or c.name like '%passport%'
)
