$Hosts = Get-Content .\hosts.txt

$Paths = @(
"/",
"/config/",
"/state/",
"/version",
"/metrics",
"/health",
"/debug/vars",
"/debug/pprof/",
"/swagger",
"/openapi.json"
)

$ResultFile = ".\HTTP_Results.csv"

"Host,Path,StatusCode,ContentType,Length,Interesting" | Out-File $ResultFile

foreach($Host in $Hosts)
{
    foreach($Path in $Paths)
    {
        $Url = "http://$Host`:6165$Path"

        Write-Host $Url

        try
        {
            $Response = Invoke-WebRequest `
                -Uri $Url `
                -UseBasicParsing `
                -TimeoutSec 10

            $Interesting=""

            if($Response.StatusCode -eq 200)
            {
                $Interesting="YES"
            }

            "$Host,$Path,$($Response.StatusCode),$($Response.Headers.'Content-Type'),$($Response.RawContentLength),$Interesting" |
                Add-Content $ResultFile

            $Folder=".\\Responses\\" + $Host.Replace(".","_")

            if(!(Test-Path $Folder))
            {
                New-Item -ItemType Directory $Folder | Out-Null
            }

            $Name=$Path.Replace("/","_")

            if($Name -eq "_")
            {
                $Name="root"
            }

            $Response.Content | Out-File "$Folder\$Name.txt"

        }
        catch
        {
            "$Host,$Path,FAILED,,," | Add-Content $ResultFile
        }
    }
}

Write-Host ""
Write-Host "Completed."
Write-Host "Summary: HTTP_Results.csv"


scan-http.ps1
powershell -ExecutionPolicy Bypass -File .\scan-http.ps1
