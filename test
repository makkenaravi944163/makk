# ============================================
# Bulk HTTP Endpoint Scanner
# Reads hosts from hosts.txt
# ============================================

$Hosts = Get-Content ".\hosts.txt" | Where-Object { $_.Trim() -ne "" }

$Paths = @(
"/",
"/config/",
"/state/",
"/version",
"/metrics",
"/health",
"/debug/vars",
"/debug/pprof/",
"/swagger",
"/openapi.json"
)

$OutputDir = ".\Responses"
$CsvFile = ".\HTTP_Results.csv"

if (!(Test-Path $OutputDir)) {
    New-Item -ItemType Directory -Path $OutputDir | Out-Null
}

"Host,Path,StatusCode,ContentType,Length,Interesting" | Out-File $CsvFile

foreach ($TargetHost in $Hosts)
{
    Write-Host ""
    Write-Host "===================================="
    Write-Host "Scanning $TargetHost"
    Write-Host "===================================="

    $HostFolder = Join-Path $OutputDir ($TargetHost.Replace(".", "_"))

    if (!(Test-Path $HostFolder))
    {
        New-Item -ItemType Directory -Path $HostFolder | Out-Null
    }

    foreach ($Path in $Paths)
    {
        $Url = "http://$($TargetHost):6165$Path"

        Write-Host $Url

        try
        {
            $Response = Invoke-WebRequest `
                -Uri $Url `
                -UseBasicParsing `
                -TimeoutSec 10 `
                -ErrorAction Stop

            $Status = $Response.StatusCode
            $Type = $Response.Headers["Content-Type"]
            $Length = $Response.RawContentLength

            $Interesting = ""

            if($Status -eq 200)
            {
                $Interesting = "YES"
            }

            "$TargetHost,$Path,$Status,$Type,$Length,$Interesting" |
                Add-Content $CsvFile

            $FileName = $Path.Replace("/","_")

            if([string]::IsNullOrWhiteSpace($FileName))
            {
                $FileName = "root"
            }

            $FileName = $FileName.Trim("_")

            if($FileName -eq "")
            {
                $FileName = "root"
            }

            $Response.Content | Out-File "$HostFolder\$FileName.txt" -Encoding utf8

            Write-Host "  [+] $Status" -ForegroundColor Green
        }
        catch
        {
            $ErrorCode = ""

            if ($_.Exception.Response)
            {
                try
                {
                    $ErrorCode = $_.Exception.Response.StatusCode.value__
                }
                catch
                {
                    $ErrorCode = "ERROR"
                }
            }
            else
            {
                $ErrorCode = "FAILED"
            }

            "$TargetHost,$Path,$ErrorCode,,," | Add-Content $CsvFile

            Write-Host "  [-] $ErrorCode" -ForegroundColor Red
        }
    }
}

Write-Host ""
Write-Host "======================================"
Write-Host "Completed!"
Write-Host "CSV Report : $CsvFile"
Write-Host "Responses  : $OutputDir"
Write-Host "======================================"
