javascript:(function(){
    function run(){
        setInterval(()=>{
            document.dispatchEvent(new MouseEvent('mousemove',{
                clientX:Math.random()*window.innerWidth,
                clientY:Math.random()*window.innerHeight
            }));
            window.scrollBy(0,Math.random()*50);
        },5000);

        setTimeout(()=>{
            location.reload();
        },30000);
    }

    run();

    // re-run after load
    window.addEventListener('load', run);
})();
