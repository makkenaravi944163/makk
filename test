import java.io.*;
import java.net.*;
import java.nio.file.Files;
import java.nio.file.Paths;

public class TcpClient {

    public static void main(String[] args) {

        try {

            // Read XML file
            String xml = new String(
                    Files.readAllBytes(
                            Paths.get("tcprequest.xml")));

            // Server details
            String host = "viqtcgl1";
            int port = 2036;

            // Open socket
            Socket socket = new Socket(host, port);

            socket.setSoTimeout(10000);

            BufferedReader reader =
                    new BufferedReader(
                            new InputStreamReader(
                                    socket.getInputStream()));

            PrintWriter writer =
                    new PrintWriter(
                            socket.getOutputStream(),
                            true);

            // STEP 1
            // Send protocol handshake
            String handshake = "MATE SELECT 1.0";

            System.out.println("Sending:");
            System.out.println(handshake);

            writer.println(handshake);
            writer.flush();

            // Read handshake response
            String response;

            System.out.println("Handshake Response:");

            while ((response = reader.readLine()) != null) {

                System.out.println(response);

                // Stop after ACCEPT
                if (response.contains("ACCEPT")) {
                    break;
                }
            }

            // STEP 2
            // Send XML payload
            System.out.println("Sending XML:");

            writer.println(xml);
            writer.flush();

            socket.shutdownOutput();

            // Read final response
            System.out.println("Server Final Response:");

            while ((response = reader.readLine()) != null) {
                System.out.println(response);
            }

            // Close
            reader.close();
            writer.close();
            socket.close();

            System.out.println("Request completed.");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
